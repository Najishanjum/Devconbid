# ==============================================================================
# PocketBillboard — Payment System Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your verified values.
# IMPORTANT:
# - Never commit real private keys, seed phrases, or production credentials.
# - PocketBillboard never requests your wallet private key or recovery phrase.
# - If required settings are left empty, the site will show a setup requirement
#   banner and disable the respective payment option to prevent accidental losses.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPTION A: INR via UPI Configuration
# ------------------------------------------------------------------------------
# Your official Virtual Payment Address (VPA) / UPI ID (e.g., yourname@okhdfcbank, business@upi)
UPI_VPA=

# Your verified Payee Name as displayed in banking / UPI apps (e.g., "Najish Anjum" or "Your Studio LLC")
UPI_PAYEE_NAME=

# (Optional) Direct URL or path to a pre-generated valid static UPI QR code image.
# If left empty, the system automatically generates an order-specific dynamic QR code with the exact payable amount and reference.
UPI_QR_IMAGE_URL=

# Server-side configured USD-to-INR conversion rate policy.
# Example: 84.50 (meaning 1 USD = 84.50 INR).
# The final payable INR amount is calculated and locked when the payment session is created.
USD_INR_RATE=84.50

# ------------------------------------------------------------------------------
# 2. OPTION B: USDC on Base Mainnet Configuration
# ------------------------------------------------------------------------------
# Your verified Base receiving wallet address (0x followed by 40 hex characters).
# Compatible with MetaMask, Trust Wallet, Phantom, Coinbase Wallet.
# WARNING: Verify that this address supports native USDC on Base (Chain ID: 8453).
BASE_USDC_RECEIVER_ADDRESS=

# Base Mainnet JSON-RPC endpoint URL.
# You can use the public Base RPC or your private RPC URL from Alchemy, Infura, or QuickNode.
# Default public node: https://mainnet.base.org
BASE_RPC_URL=https://mainnet.base.org

# Confirmation Policy: Number of block confirmations required before confirming payment on Base.
# Default: 1 (recommended for Base L2 fast finality).
BASE_USDC_CONFIRMATION_POLICY=1

# Native USDC Token Contract on Base (Circle official: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913)
# Note: Native USDC on Base uses 6 decimal places. Bridged USDbC is strictly rejected.

# ------------------------------------------------------------------------------
# 3. Optional Supabase Database Configuration
# ------------------------------------------------------------------------------
# If you are connecting to a Supabase project, supply these credentials.
# By default, local persistent file storage (data/payments_db.json) is used out of the box.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key should ONLY be kept on the secure server, NEVER exposed to client!
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. Server Port & Network
# ------------------------------------------------------------------------------
PORT=5173
HOST=localhost
